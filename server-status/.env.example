# Copy to server-status/.env and fill in.
# Your own infrastructure that must never be checked: IPs or CIDRs, comma or space separated
# (the machine running the checker, game nodes, panels, VPN ranges). Leave empty if you have none.
TOOLS_BLOCK_IPS=<INFRA_IPS>
# 1 = also check IPv6 targets (only if the machine has IPv6).
TOOLS_IPV6=0
